# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# HTTP port (Render injects PORT; the Dockerfile maps it onto SERVER_PORT)
SERVER_PORT=8080

# PostgreSQL. For Neon, take the connection string from the dashboard and split it:
#   postgresql://<user>:<password>@<host>/<db>?sslmode=require
# becomes
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
SPRING_DATASOURCE_USERNAME=<user>
SPRING_DATASOURCE_PASSWORD=<password>

# Python prediction microservice (the service implementing BUILD_SPEC §3)
PREDICTOR_URL=https://predictor-ml-zntu.onrender.com
PREDICTOR_API_KEY=

# HS256 signing key, at least 32 bytes
JWT_SECRET=change-me-dev-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=86400000

# Frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000
